# --- Supabase (menu data, admin dashboard, orders) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mollie (iDEAL / cards / Klarna payments) ---
MOLLIE_API_KEY=

# --- Google Maps (delivery radius check, distance/ETA) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Mapbox (homepage delivery-area map) ---
# Account -> your default public token, at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Email notifications (Resend) ---
# A new paid order sends a "new order" email so it's not missed if no one's
# looking at the dashboard. Get a key at https://resend.com, verify the
# kebabish.nl sending domain there, then set this. Without it, the app just
# logs a warning and moves on — no email, but nothing breaks.
RESEND_API_KEY=
# Where the new-order email goes. Defaults to siteConfig.contact.email if
# left blank.
ORDER_NOTIFICATION_EMAIL=

# --- Email marketing (Brevo) ---
# Brevo handles marketing only — campaigns, newsletters, announcements. Every
# transactional email (receipts, password resets, order status) still goes
# through Resend above, and the two never touch.
#
# Get a key at https://app.brevo.com -> SMTP & API -> API keys, and verify the
# kebabish.nl sending domain there (Brevo needs its own DKIM records; they sit
# alongside Resend's quite happily). Without this key the Email marketing
# section says it isn't connected and nothing else is affected.
BREVO_API_KEY=
# Brevo does not sign its webhooks, so the webhook we register with it carries
# a bearer token instead. Anything long and random; /api/brevo/webhook refuses
# every request unless it matches. Leaving this blank refuses everything,
# rather than accepting anything.
BREVO_WEBHOOK_SECRET=

# Secret for /api/cron/housekeeping (slot release + unaccepted-order email).
# Anything long and random. Whatever calls that endpoint once a minute —
# Vercel Cron or an external pinger — sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# --- WhatsApp ordering ---
NEXT_PUBLIC_WHATSAPP_NUMBER=31684011572

# --- Admin dashboard auth ---
ADMIN_SESSION_SECRET=

# --- Coming soon gate ---
# Set to "true" to show only /coming-soon publicly (the real site 307s to
# it); everything under /admin stays fully working regardless. Flip back to
# "false" (or delete the line) to go live — that's the entire launch switch.
SITE_COMING_SOON=false
# Special link to preview the real site while gated: any page URL +
# ?preview=<this value> grants a 90-day bypass cookie to that browser.
COMING_SOON_PREVIEW_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.kebabish.nl

# --- Local development only ---
# The store uses Supabase whenever the keys above are set — including on
# your machine, so `npm run dev` edits the real shop's live menu. Put
# STORE_ADAPTER=json in .env.local to work against the local .data file
# instead. Never set this in Vercel: the filesystem there is read-only.
# STORE_ADAPTER=json
